# Generate a production value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///shop_alert.db

# Optional. Enables Google Place Autocomplete on the report form.
# Restrict this browser key to your deployed domains in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Account email allowed to review report-contact submissions at /admin/report-contacts.
ADMIN_EMAIL=

# Optional. When set with ADMIN_EMAIL, the admin account is created at startup if
# missing and its login password is kept in sync with this value (min 8 chars).
ADMIN_PASSWORD=

# Optional. With ADMIN_EMAIL, forces the admin account's login username at startup
# (3-30 letters, numbers, or underscores); admin can log in with it or the email.
ADMIN_USERNAME=

# Failed-login protection. Attempts are scoped to each email + client IP pair.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Optional locally; configure both keys together to require Cloudflare Turnstile
# on login and sign-up. Set the hostname in production to validate token origin.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Server-generated controversy-link screenshots (Playwright Chromium).
LINK_PREVIEW_TIMEOUT_SECONDS=15
LINK_PREVIEW_SETTLE_MS=1500
LINK_PREVIEW_CACHE_HOURS=24

# Optional locally; configure both to check controversy links with an unlisted
# Cloudflare URL Scanner scan. Give the token Account > URL Scanner > Edit.
CLOUDFLARE_URL_SCANNER_ACCOUNT_ID=
CLOUDFLARE_URL_SCANNER_API_TOKEN=
CLOUDFLARE_URL_SCANNER_REQUEST_TIMEOUT_SECONDS=10
CLOUDFLARE_URL_SCANNER_RESULT_TIMEOUT_SECONDS=40
CLOUDFLARE_URL_SCANNER_POLL_INTERVAL_SECONDS=10
CLOUDFLARE_URL_SCANNER_CACHE_HOURS=24

# Upload settings
MAX_CONTENT_LENGTH_MB=50
